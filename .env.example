# Point this at your vLLM box. Keep the /v1 suffix.
FIELDWORK_LLM_BASE_URL=http://localhost:8000/v1
FIELDWORK_LLM_API_KEY=EMPTY
FIELDWORK_LLM_MODEL=gemma-4-12B-it

# Longest edge in pixels after preprocessing. This is your primary
# speed-vs-OCR-detail dial. 1536 is a good starting point for dense
# documents; drop to 1024 if latency hurts, raise to 2048 for fine print.
FIELDWORK_MAX_IMAGE_DIM=1536

# Gemma 4 exposes a visual token budget (70/140/280/560/1120). The exact
# kwarg name depends on your vLLM version, so it is passed through verbatim
# as extra_body. Leave empty to let the server decide. Verify against your
# server before trusting it -- see README "Visual token budget".
FIELDWORK_EXTRA_BODY={}

FIELDWORK_TEMPERATURE=0.0
FIELDWORK_MAX_TOKENS=4096
FIELDWORK_REQUEST_TIMEOUT=180
FIELDWORK_MAX_REPAIR_ATTEMPTS=2

# Phase 1 upload guards
FIELDWORK_MAX_UPLOAD_MB=20
FIELDWORK_MAX_PDF_PAGES=8
