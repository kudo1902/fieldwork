  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Presigned PUT sends bytes straight to MinIO",
        "API dedupes on content SHA-256, then enqueues",
        "202 + job_id; progress streams back over SSE"
      ]
    },
    {
      "dot": "emerald",
      "title": "Inference tier",
      "items": [
        "vLLM: continuous batching + prefix caching",
        "Guided decoding against the JSON Schema",
        "Private network only — never public"
      ]
    },
    {
      "dot": "violet",
      "title": "Accuracy loop",
      "items": [
        "OCR cross-check plus arithmetic rules",
        "Confidence routes to auto-accept or human",
        "Corrections grow the eval set, which gates changes"
      ]
    },
    {
      "dot": "rose",
      "title": "Operations",
      "items": [
        "One box, Docker Compose, weights on a volume",
        "OTel traces and Prometheus metrics",
        "Retention TTL and audit log"
      ]
    }
